{
  "name": "x402project",
  "version": "0.1.0",
  "private": true,
  "description": "Agent Spend Policy Guard - policy-enforcement gateway for x402 autonomous payments",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/core/db/seed.ts",
    "db:reset": "tsx src/core/db/reset.ts",
    "poc:x402": "tsx src/payments/scripts/poc-x402.ts",
    "wallet:fund": "tsx src/payments/scripts/fund-wallet.ts",
    "bench": "tsx src/core/scripts/bench-evaluate.ts",
    "sim": "tsx src/demo/simulator/index.ts",
    "agent": "tsx src/demo/agent/run.ts",
    "drills": "tsx src/demo/drills/index.ts",
    "docs:pdf": "node ../Docs/tools/md2pdf.js ../Docs/PRD.md ../Docs/ARCHITECTURE.md ../Docs/API_DOCS.md ../Docs/DEVELOPMENT_PLAN.md ../Docs/REPO_STRUCTURE.md"
  },
  "dependencies": {
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^3.24.1",
    "drizzle-orm": "^0.38.3",
    "postgres": "^3.4.5",
    "viem": "^2.22.0",
    "ulid": "^2.3.0",
    "swr": "^2.3.0",
    "recharts": "^2.15.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.6.0",
    "lucide-react": "^0.469.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8",
    "msw": "^2.7.0"
  },
  "_installNotes": {
    "x402": "PAY installs these in Phase 0 after pinning the real versions: pnpm add @x402/fetch @x402/evm @x402/next",
    "llm": "DEMO installs these in Phase 4c, only for the prompt-injection demo: pnpm add ai @ai-sdk/groq",
    "ui": "UI runs `npx shadcn@latest init` once, then adds components on demand"
  }
}
