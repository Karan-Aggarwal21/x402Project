# ============================================================================
# ASPG environment. Copy to .env.local. Real values go in the team group chat.
# .env.local is git-ignored. Never commit a key. Testnet keys only.
# ============================================================================

# --- CORE owns ---
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# --- PAY owns ---
AGENT_WALLET_PRIVATE_KEY="0x..."          # Base Sepolia TESTNET key only
X402_FACILITATOR_URL="https://x402.org/facilitator"
BASE_SEPOLIA_RPC_URL="https://sepolia.base.org"
GUARD_HMAC_SECRET="dev-only-change-me"    # signs the allowToken

# --- DEMO owns ---
MERCHANT_WALLET_ADDRESS="0x..."           # receives sandbox payments
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Optional, non-decisional (CORE) ---
GROQ_API_KEY=""                           # NL -> policy draft + explanations only

# --- Local switches ---
USE_MOCKS="0"                             # 1 = use every owner's mock/ instead of the real module

